# 此 .gitignore 文件应放置在 Unity 项目目录的根目录下
# 从 https://github.com/github/gitignore/blob/master/Unity.gitignore 获取最新信息

# 一个标记文件，其存在用于决定是否进行 run 首次启动体验。
InitCodeMarker
/[Tt]utorial [Dd]efaults/

# 打包的模板在这里
upm-ci~/
upm-ci.log

# 永远不要忽略资产元数据。..
!/[Aa]ssets/**/*.meta

# 使用设置管理器实现的用户特定于项目的设置
/ProjectSettings/Packages

/[Aa]ssets/SceneDependencyCache/

# 其余的是 Unity 项目的通用最佳实践
/.Editor/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Vv]alidationSuiteResults/

# 使用设置管理器进行项目/用户特定设置
/ProjectSettings/Packages/
# UserSettings 2020.1 推出
/UserSettings/

# 如果您想忽略资产商店工具插件，请取消注释此行
/[Aa]ssets/AssetStoreTools*

# 自动生成的 Jetbrains Rider 插件
[Aa]ssets/Plugins/Editor/JetBrains*

# 骑士
.idea/

# Visual Studio 缓存目录
.vs/

# Visual Studio Code 设置目录
.vscode/

# Gradle 缓存目录
.gradle/

# 自动生成的 VS/MD/Consulo 解决方案和项目文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D 生成元文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D 生成的崩溃报告文件
sysinfo.txt

# 构建
*.apk
*.unitypackage

# Crashlytics 生成的文件
crashlytics-build.properties
*.orig
*.orig.meta

# 忽略构建报告
/Assets/BuildReports*

# Mac 文件设置
.DS_Store
