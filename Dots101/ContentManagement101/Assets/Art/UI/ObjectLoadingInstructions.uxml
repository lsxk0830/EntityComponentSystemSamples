<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Art/UI/Style.uss?fileID=7433441132597879392&amp;guid=8e947b7abd44d144fad84edec4391f30&amp;type=3#Style" />
    <engine:VisualElement name="menu" class="container" style="visibility: visible; overflow: visible; opacity: 1; scale: 0.85 0.85; transform-origin: right top; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
        <engine:Label text="指示" class="text" />
        <engine:Label text="按 &lt;b&gt;&lt;color=#A4A449&gt;Enter&lt;/color&gt;&lt;/b&gt; 键可在 &lt;b&gt;&lt;color=#A4A449&gt;low&lt;/color&gt;&lt;/b&gt; 和 &lt;b&gt;&lt;color=#A4A449&gt;high&lt;/color&gt;&lt;/b&gt; 保真度之间切换。" style="-unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/ShareTechMono-Regular/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=ba952712555b503458be5a0ebcad7e60&amp;type=3#ShareTechMono-Regular&quot;); color: rgb(255, 255, 255); font-size: 20px; white-space: pre-wrap;" />
        <engine:Label text="请按照以下分步说明了解 scene 的工作原理：&lt;b&gt;&lt;color=magenta&gt;1.&lt;/color&gt;&lt;/b&gt; 了解更多请前往&lt;b&gt;&lt;color=#A4A449&gt;LoadingLocalCatalogSystem&lt;/color&gt;&lt;/b&gt;&#10;   有关如何初始化内容的详细信息&#10;   来自构建中的 StreamingAssets 文件夹。&lt;b&gt;&lt;color=magenta&gt;2.&lt;/color&gt;&lt;/b&gt; 检查 &lt;b&gt;&lt;color=#A4A449&gt;WeakRenderedObjectAuthoring&lt;/color&gt;&lt;/b&gt; 或&#10;   &lt;b&gt;&lt;color=#A4A449&gt;WeakObjectLoadingSystem&lt;/color&gt;&lt;/b&gt; 如何检查&#10;   将引用分配给 entity。&lt;b&gt;&lt;color=magenta&gt;3.&lt;/color&gt;&lt;/b&gt; 切换至&lt;b&gt;&lt;color=#A4A449&gt;[平台] WeakObjectLoading&#10;   构建播放器之前的 profile&lt;/color&gt;&lt;/b&gt;。" style="-unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/ShareTechMono-Regular/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=ba952712555b503458be5a0ebcad7e60&amp;type=3#ShareTechMono-Regular&quot;); color: rgb(255, 255, 255); font-size: 20px; white-space: pre-wrap; width: 530px; padding-bottom: 12px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgba(133, 133, 133, 0.5);" />
        <engine:Label text="&lt;b&gt;&lt;color=#A4A449&gt;Note:&lt;/color&gt;&lt;/b&gt; 内容管理依赖于 subscenes 将内容引用烘焙到 entities 中。你会发现 scenes 仅包含 subscenes；此模式允许直接加载 scene，而无需创建运行时 entity，因为所有内容都是在内容目录导出期间预先构建的。" style="-unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/ShareTechMono-Regular/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=ba952712555b503458be5a0ebcad7e60&amp;type=3#ShareTechMono-Regular&quot;); color: rgb(255, 255, 255); font-size: 20px; white-space: pre-wrap; width: 518px;" />
    </engine:VisualElement>
</engine:UXML>
